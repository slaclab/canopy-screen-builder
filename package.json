{
  "name": "canopy-screen-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Drag-and-drop screen builder for Canopy control system displays",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss}\"",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.91.0",
    "@carbon/react": "^1.119.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ibm/plex-mono": "^1.1.0",
    "@ibm/plex-sans": "^1.1.0",
    "@ibm/plex-serif": "^1.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@slaclab/canopy-screen-ir": "^0.3.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "immer": "^11.2.9",
    "nanoid": "^5.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "github:testing-library/jest-dom",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "github:testing-library/user-event",
    "@types/node": "^24.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.6.0",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.1.1"
}
